{# == Node Type Name           : Materialized View Stage == #}
{# == Node Type Description    : This node creates a materialized view == #}


{% if desiredState %}
{# Dynamic data masking policy location #}

{%if desiredState.config.enableMasking%}
  {% set maskStorageLocationName = desiredState.config.maskStorageLocationName|trim %}
  {% set dbmask =  ref_no_link(desiredState.config.maskStorageLocationName, node.name).split('.')[0] %}
  {% set schmask =  ref_no_link(desiredState.config.maskStorageLocationName, node.name).split('.')[1]%}
{%endif%}


{# Row access policy location #}
{%-if desiredState.config.enablerowacessMasking%}
  {% set racessStorageLocationName = desiredState.config.raccessStorageLocationName|trim %}
  {% set dbaccess =  ref_no_link(racessStorageLocationName, node.name).split('.')[0] %}
  {% set schaccess =  ref_no_link(racessStorageLocationName, node.name).split('.')[1]%}
{%endif%}

{# Override Masking sql #}

    {% set ns = namespace(column_masking=[],constraint='',raccol=[]) %} 

    {%if desiredState.config.maskingOverride == true %}
 
      {% for item in desiredState.config.ovmaskcolumn.get('items') %}
        {% set column_name = item.smaskcolumn.name %}
        {% set spolicyname = item.spolicyname %}

       {# Create a temporary dictionary for the current item #}
       {% set col_dict = {'name': column_name, 'masname': spolicyname} %}

       {# Append the dictionary to the list in the namespace #}
       {% set ns.column_masking = ns.column_masking + [col_dict] %}
      {% endfor %}          
 
    {%endif%}

    {#Row access policy column names #}

   {%-if desiredState.config.enablerowacessMasking%}
     
     {% for item in desiredState.config.racccolumn.get('items')%}
       {%- if loop.first -%}
        {%set ns.raccol = '"'+item.racccolumnname.name+'"' %}
       {%else%}
        {%set ns.raccol = ns.raccol + ',"' +item.racccolumnname.name + '"'%}

       {%endif%}
     {%endfor%}
   {% endif %}

    {# Identify all config changes that would cause a CREATE instead of ALTER #}
    {% if currentState != undefined %} 
        {# General metadata #}
        {% set columnsTest = currentState.columns == desiredState.columns %}
        {% set joinTest = currentState.sources[0].join == desiredState.sources[0].join %}

        {# Test to see if the transform in a column has changed #}
        {# Desired Namespace Variables Transform #}
        {% set desiredTransformArray = desiredState.sources | map(attribute='columns') | first | map(attribute='transform') | list -%}

        {# Test to see if the transform in a column has changed #}
        {# Current Namespace Variables Transform #}
        {% set currentTransformArray = currentState.sources | map(attribute='columns') | first | map(attribute='transform') | list -%}

        {% set columnsTransformTest = currentTransformArray == desiredTransformArray %}

            
        {# Config #}
        {% set selectDistinctTest = currentState.config.selectDistinct | default(false) == desiredState.config.selectDistinct %}

        {# Node #}
        {% set nodeMaterializationType = currentState.node.materializationType == desiredState.node.materializationType %}

        {% set maskingPolicyTest = currentState.config.enableMasking | default(false) == desiredState.config.enableMasking %}

        {# If any of the above are false then a CREATE must be run #}
        {% if 
            columnsTest == false or
            joinTest == false or
            columnsTransformTest == false or
            selectDistinctTest == false or
            maskingPolicyTest == false or 
            nodeMaterializationType == false  %}    

            {% set createTest = true %}
        {% else %}
            {% set createTest = false %}
        {% endif %}
    {% endif %}

    {# Identify config changes that would only result in ALTER #}
    {% if createTest == false %}
         {# Desired Namespace Variables #}

        {% set nsVariables = namespace(storageLocationTest= true ) %}

         {# Change Node Name or Change Storage Location #}
            {# Storage Location Tests #}
            {# Test  #}
            {%if currentState.storageLocations|length == 0%}          
              {% set currentDatabase = currentState.storageLocations | selectattr('name', 'equalto', currentState.node.location.name) | map(attribute='database') | string %}
              {% set currentSchema = currentState.storageLocations | selectattr('name', 'equalto', currentState.node.location.name) | map(attribute='schema') | string %}
               {% set currentDatabaseSchema = currentDatabase + '.' + currentSchema %}
               
            {%else %}   
            {# Current target node mappings #}
            {% set currentDatabase = currentState.storageLocations | selectattr('name', 'equalto', currentState.node.location.name) | map(attribute='database') | first %}
            {% set currentSchema = currentState.storageLocations | selectattr('name', 'equalto', currentState.node.location.name) | map(attribute='schema') | first %}
            {% set currentDatabaseSchema = currentDatabase + '.' + currentSchema %}  
			{% endif %}		 
        
            {# Desired target node mappings #}
            {% set desiredDatabase = desiredState.storageLocations | selectattr('name', 'equalto', desiredState.node.location.name) | map(attribute='database') | first %}
            {% set desiredSchema = desiredState.storageLocations | selectattr('name', 'equalto', desiredState.node.location.name) | map(attribute='schema') | first %}
            {% set desiredDatabaseSchema = desiredDatabase + '.' + desiredSchema %}           
            
             {% if currentDatabaseSchema != desiredDatabaseSchema %}
                {% set nsVariables.storageLocationTest = false %}
             {% endif %}
        
        {% set nodeNameTest = currentState.node.name == desiredState.node.name %}

        {% set secureOptionTest = currentState.config.secureOption | default(false) == desiredState.config.secureOption %}

        {% set nodeCommentTest = currentState.node.description == desiredState.node.description %}

        {# Clustering Test #}
        {% set clusterKeyTest = currentState.config.clusterKey | default(false) == desiredState.config.clusterKey %}
        {% set clusterKeyExpressionsTest = currentState.config.clusterKeyExpressions | default(false) == desiredState.config.clusterKeyExpressions %}
        {% set clusterKeyConfigTest = currentState.config.clusterKeyConfig | default({'items': [{}]}) == desiredState.config.clusterKeyConfig %}
        {% set clusterKeyConfigExpressionsTest = currentState.config.clusterKeyConfigExpressions | default({'items': [{}]}) == desiredState.config.clusterKeyConfigExpressions %}

        {% if 
            clusterKeyTest == false or
            clusterKeyExpressionsTest == false or
            clusterKeyConfigTest == false or
            clusterKeyConfigExpressionsTest == false %}

            {% set clusterTest = false %}
        {% else %}
            {% set clusterTest = true %}
        {% endif %}

        {# Masking and Row Access Policy change tests #}
        {% set maskingOverrideTest = currentState.config.maskingOverride | default(false) == desiredState.config.maskingOverride %}
        {% set maskingColumnsTest = currentState.config.ovmaskcolumn | default({'items':[]}) == desiredState.config.ovmaskcolumn %}
        {% set maskingPolicyNameTest = currentState.config.selMaskPolicy | default('') == desiredState.config.selMaskPolicy %}
        {% set maskingLocationTest = currentState.config.maskStorageLocationName | default('') == desiredState.config.maskStorageLocationName | default('') %}
        {% set rowAccessPolicyTest = currentState.config.enablerowacessMasking | default(false) == desiredState.config.enablerowacessMasking %}
        {% set rowAccessPolicyNameTest = currentState.config.rowaccessPolicy | default('') == desiredState.config.rowaccessPolicy %}
        {% set rowAccessColumnsTest = currentState.config.racccolumn | default({'items':[]}) == desiredState.config.racccolumn %}
        {% set rowAccessLocationTest = currentState.config.raccessStorageLocationName | default('') == desiredState.config.raccessStorageLocationName | default('') %}
        

        {% if 
            nodeNameTest == false or
            clusterTest == false or
            secureOptionTest == false or
            nodeCommentTest == false or
            maskingPolicyNameTest == false or
            maskingOverrideTest == false or
            maskingColumnsTest == false or
            maskingLocationTest == false or
            rowAccessPolicyTest == false or
            rowAccessPolicyNameTest == false or
            rowAccessColumnsTest == false or
            rowAccessLocationTest == false or
            currentState.node.location.name != desiredState.node.location.name or 
            nsVariables.storageLocationTest == false %}    
            {% set alterOnlyTest = true %}
        {% else %}
            {% set alterOnlyTest = false %}
        {% endif %}
    {% endif %}


    {# CREATE or ALTER #}
    {% if (currentState == undefined) or (createTest == true) %}

        {# Materialized View Name #}
        {% set targetMaterializedViewDatabase = ref_no_link(desiredState.node.location.name, desiredState.node.name).split('.')[0] %} 
        {% set targetMaterializedViewSchema = ref_no_link(desiredState.node.location.name, desiredState.node.name).split('.')[1] %} 
        {% set fullyQualifiedTargetMaterializedViewName = ref_no_link(desiredState.node.location.name, desiredState.node.name) %}

        {# Figure out cluster key #}
        {% set nsVariables = namespace(finalClusterKey="") %}
        {% if desiredState.config.clusterKey == true %}
            {% if desiredState.config.clusterKeyExpressions == true %}
                {% set column, expression = desiredState.config.clusterKeyConfigExpressions.get('items') | map(attribute='columnNameExpressions.name') | list, desiredState.config.clusterKeyConfigExpressions.get('items') | map(attribute='sqlExpression') | list %}

                {%- set nsVariables = namespace(clusterValues=[]) %}

                {% for r in column %}
                    {% if expression[loop.index0] == "" %}
                        {% set nsVariables.clusterValues = nsVariables.clusterValues + ['"'+r+'"'] %}
                    {% else %}
                        {% set nsVariables.clusterValues = nsVariables.clusterValues + [expression[loop.index0]] %}
                    {% endif %}
                {% endfor %}

                {% set nsVariables.finalClusterKey = 'CLUSTER BY (' + nsVariables.clusterValues | join(',') + ')' %}

            {% else %}

                {% set column = desiredState.config.clusterKeyConfig.get('items') | map(attribute='columnName.name') | list %}

                {%- set nsVariables = namespace(clusterValues=[]) %}

                {% for r in column %}
                    {% set nsVariables.clusterValues = nsVariables.clusterValues + ['"'+r+'"'] %}
                {% endfor %}

                {% set nsVariables.finalClusterKey = 'CLUSTER BY (' + nsVariables.clusterValues | join(',') + ')' %}

            {% endif %}
        {% endif %}
        {% if createTest == true and  currentState.node.materializationType != desiredState.node.materializationType %}
            {# Change in materialization type #}
            {{ stage('Drop ' + ref_no_link(currentState.node.location.name, currentState.node.name)) }}
            {%- set materialization = dropMaterialization(currentState.node.materializationType) %}
            DROP {{ materialization }} {{ ref_no_link(currentState.node.location.name, currentState.node.name) }}

        {% endif %}

        {{ stage('Create Masking Enabled Materialized View', true, "sql", "create") }}
            CREATE OR REPLACE {% if desiredState.config.secureOption %} SECURE {% endif %}
            MATERIALIZED VIEW {{ fullyQualifiedTargetMaterializedViewName }}
            (
                {% for col in desiredState.columns %}
                    {%set ns.masking = ''%}
                    {%set ns.flag = false%}

                    {# Match column to masking policy from ovmaskcolumn config #}
                    {% for item in ns.column_masking %}
                        {% if item.name == col.name and ns.flag == false %}
                            {% set ns.masking = item.masname %}
                            {% set ns.flag = true %}
                        {% endif %}
                    {% endfor %}

                    "{{ col.name }}"
                    {#Use the macro for column matches#}
                    {%- if (desiredState.config.enableMasking and maskingLookup(col.name) | trim == 'yes') and not desiredState.config.maskingOverride  %} {{' MASKING POLICY'}} {{dbmask}}.{{schmask}}."{{desiredState.config.selMaskPolicy}}"{%endif%}

                    {# Apply masking policy using dbmask/schmask from storage location #}
                    {%- if desiredState.config.enableMasking and desiredState.config.maskingOverride and ns.masking %}
                        MASKING POLICY {{dbmask}}.{{schmask}}."{{ns.masking}}"
                    {%endif%}

                    {%- if col.description | length > 0 %} COMMENT '{{ col.description | escape }}'{% endif %}
                    {%- if not loop.last -%}, {% endif %}
                {% endfor %}
            )

            {%- if desiredState.node.description | length > 0 %}
                COMMENT = '{{ desiredState.node.description | escape }}'
            {% endif %}

            {%- if desiredState.config.enablerowacessMasking %}
                WITH ROW ACCESS POLICY {{dbaccess}}.{{schaccess}}."{{desiredState.config.rowaccessPolicy}}" ON({{ns.raccol}})
            {% endif %}

            AS

            {% for source in desiredState.sources %}
                SELECT {% if desiredState.config.selectDistinct %} DISTINCT {% endif %}
                {% for col in source.columns %}
                    {{ get_source_transform(col) }} AS "{{ col.name }}"
                    {%- if not loop.last -%}, {% endif %}
                {% endfor %}
                {{ source.join }}
            {% endfor %}

        {% if desiredState.config.clusterKey == true %}
            {{ stage('Apply Materialized View Clustering', true, "sql", "create") }}
            ALTER MATERIALIZED VIEW {{ fullyQualifiedTargetMaterializedViewName }} {{ nsVariables.finalClusterKey }}

            {{ stage('Resume Recluster Materialized View', true, "sql", "create") }}
            ALTER MATERIALIZED VIEW {{ fullyQualifiedTargetMaterializedViewName }} RESUME RECLUSTER
        {% endif %}

    {% elif (currentState != undefined) and (alterOnlyTest == true) %}

        {# Desired Materialized View Name #}
        {% set desiredTargetMaterializedViewDatabase = ref_no_link(desiredState.node.location.name, desiredState.node.name).split('.')[0] %} 
        {% set desiredTargetMaterializedViewSchema = ref_no_link(desiredState.node.location.name, desiredState.node.name).split('.')[1] %} 
        {% set desiredFullyQualifiedTargetMaterializedViewName = ref_no_link(desiredState.node.location.name, desiredState.node.name) %}
        {% set currentFullyQualifiedTargetMaterializedViewName = ref_no_link(currentState.node.location.name, currentState.node.name) %}

        {# Desired Node Name #}
        {% set desiredNodeName = desiredState.node.name %}

        {# Desired Secure Option #}
        {% set desiredSecureOption = desiredState.config.secureOption %}

        {# Desired Clustering Key #}
        {% set desiredClusterKey = finalClusterKey %}

        {# Desired Comment #}
        {% set desiredNodeComment = desiredState.node.description %}

        {# Current Node Name #}
        {% set currentNodeName = currentState.node.name %}

        {# Current Secure Option #}
        {% set currentSecureOption = currentState.config.secureOption | default(false) %}

        {# Current Comment #}
        {% set currentNodeComment = currentState.node.description %}

        {# ALTER for Node name #}
        {% set materializedViewName = '' %}
        {% if desiredNodeName != currentNodeName or nsVariables.storageLocationTest == false%}
            {% set materializedViewName = 'RENAME TO ' + desiredFullyQualifiedTargetMaterializedViewName %}

            {{ stage('Alter Materialized View - Rename') }}
            ALTER MATERIALIZED VIEW {{ currentFullyQualifiedTargetMaterializedViewName }}
                {{ materializedViewName }}
        {% endif %}

        {# Figure out cluster key #}
        {% set nsVariables = namespace(finalClusterKey="") %}
        {% if clusterTest == false %}
            {% if desiredState.config.clusterKeyExpressions == true %}
                {% set column, expression = desiredState.config.clusterKeyConfigExpressions.get('items') | map(attribute='columnNameExpressions.name') | list, desiredState.config.clusterKeyConfigExpressions.get('items') | map(attribute='sqlExpression') | list %}

                {%- set nsVariables = namespace(clusterValues=[]) %}

                {% for r in column %}
                    {% if expression[loop.index0] == "" %}
                        {% set nsVariables.clusterValues = nsVariables.clusterValues + ['"'+r+'"'] %}
                    {% else %}
                        {% set nsVariables.clusterValues = nsVariables.clusterValues + [expression[loop.index0]] %}
                    {% endif %}
                {% endfor %}

                {% set nsVariables.finalClusterKey = 'CLUSTER BY (' + nsVariables.clusterValues | join(',') + ')' %}

            {% elif desiredState.config.clusterKey == true %}

                {% set column = desiredState.config.clusterKeyConfig.get('items') | map(attribute='columnName.name') | list %}

                {%- set nsVariables = namespace(clusterValues=[]) %}

                {% for r in column %}
                    {% set nsVariables.clusterValues = nsVariables.clusterValues + ['"'+r+'"'] %}
                {% endfor %}

                {% set nsVariables.finalClusterKey = 'CLUSTER BY (' + nsVariables.clusterValues | join(',') + ')' %}
            
            {% else %}

                {% set nsVariables.finalClusterKey = 'DROP CLUSTERING KEY' %}

            {% endif %}

            {{ stage('Recluster Materialized View') }}
            ALTER MATERIALIZED VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }} 
            {{ nsVariables.finalClusterKey }}

        {% endif %}

        {# ALTER for Comment #}
        {%- if desiredNodeComment != currentNodeComment %} 
        
            {{ stage('Alter Materialized View - Comment') }}
            ALTER MATERIALIZED VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                SET COMMENT = '{{ desiredState.node.description | escape }}'
        {% endif %}

        {# ALTER for Secure Option #}
        {% set materializedViewSecureOption = '' %}
        {% if desiredSecureOption != currentSecureOption %}
            {% if desiredSecureOption == true %}            
                {% set materializedViewSecureOption = 'SET SECURE' %}
            {% else %}
                {% set materializedViewSecureOption = 'UNSET SECURE' %}
            {% endif %}

            {{ stage('Alter Materialized View - Secure Option') }}
            ALTER MATERIALIZED VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                {{ materializedViewSecureOption }}
        {% endif %}

        {% if desiredState.config.clusterKey == true %}
            {{ stage('Resume Recluster Materialized View') }}
            ALTER MATERIALIZED VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }} RESUME RECLUSTER
        {% endif %}


    {# Build current masking column list for comparison #}
    {% set ns_cur = namespace(current_masking=[]) %}
    {%if currentState.config.maskingOverride == true %}
        {% for item in currentState.config.ovmaskcolumn.get('items') %}
            {% set col_dict = {'name': item.smaskcolumn.name, 'masname': item.spolicyname} %}
            {% set ns_cur.current_masking = ns_cur.current_masking + [col_dict] %}
        {% endfor %}
    {%endif%}
    

    {# ---- ENABLE MASKING : OFF -> ON ---- #}
    {% if currentState.config.enableMasking == false
        and desiredState.config.enableMasking == true %}

        {% for des_item in ns.column_masking %}

            {{ stage('Alter Materialized View - Set Masking Policy on ' + des_item.name) }}
            ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                MODIFY COLUMN "{{ des_item.name }}"
                SET MASKING POLICY {{dbmask}}.{{schmask}}."{{des_item.masname}}"

        {% endfor %}

    {% endif %}

    {# ---- ALTER DEFAULT MASKING POLICY ---- #}

        {# Default masking policy changed (Override OFF) #}
        {% if desiredState.config.enableMasking
            and desiredState.config.maskingOverride == false
            and (maskingPolicyNameTest == false  or maskingLocationTest == false) %}

            {% for col in desiredState.columns %}

                {% if maskingLookup(col.name) | trim == 'yes' %}

                    {{ stage('Alter Materialized View - Change Default Masking Policy on ' + col.name) }}
                    ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                        MODIFY COLUMN "{{ col.name }}"
                        SET MASKING POLICY {{dbmask}}.{{schmask}}."{{desiredState.config.selMaskPolicy}}" FORCE

                {% endif %}

            {% endfor %}

        {% endif %}

        {# ---- OVERRIDE MASKING : OFF -> ON ---- #}
        {% if currentState.config.enableMasking == true
            and desiredState.config.enableMasking == true
            and currentState.config.maskingOverride == false
            and desiredState.config.maskingOverride == true %}

            {# Remove existing default policy from all macro-matched columns #}
            {% for col in desiredState.columns %}

                {% if maskingLookup(col.name) | trim == 'yes' %}

                    {{ stage('Alter Materialized View - Remove Default Policy from ' + col.name) }}
                    ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                        MODIFY COLUMN "{{ col.name }}"
                        UNSET MASKING POLICY

                {% endif %}

            {% endfor %}

            {# Apply override policies #}
            {% for des_item in ns.column_masking %}

                {{ stage('Alter Materialized View - Apply Override Policy on ' + des_item.name) }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    MODIFY COLUMN "{{ des_item.name }}"
                    SET MASKING POLICY {{dbmask}}.{{schmask}}."{{ des_item.masname }}" FORCE

            {% endfor %}

        {% endif %}

        {# ---- OVERRIDE MASKING : ON -> OFF ---- #}
        {% if currentState.config.enableMasking == true
            and desiredState.config.enableMasking == true
            and currentState.config.maskingOverride == true
            and desiredState.config.maskingOverride == false %}

            {# Remove override policies #}
            {% for cur_item in ns_cur.current_masking %}

                {{ stage('Alter Materialized View - Remove Override Policy from ' + cur_item.name) }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    MODIFY COLUMN "{{ cur_item.name }}"
                    UNSET MASKING POLICY

            {% endfor %}

            {# Reapply node-level policy #}
            {% for col in desiredState.columns %}

                {% if maskingLookup(col.name) | trim == 'yes' %}

                    {{ stage('Alter Materialized View - Apply Default Policy on ' + col.name) }}
                    ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                        MODIFY COLUMN "{{ col.name }}"
                        SET MASKING POLICY {{dbmask}}.{{schmask}}."{{desiredState.config.selMaskPolicy}}" FORCE

                {% endif %}

            {% endfor %}

        {% endif %}

    {# ---- ALTER MASKING POLICY on MV columns ---- #}
        {% if (maskingPolicyTest == false or maskingColumnsTest == false or maskingPolicyNameTest == false or maskingLocationTest == false or ( maskingOverrideTest == false and not ((currentState.config.maskingOverride == false and desiredState.config.maskingOverride == true) or
        (currentState.config.maskingOverride == true and desiredState.config.maskingOverride == false)))) and not ( currentState.config.enableMasking == false and desiredState.config.enableMasking == true ) %}

        {# UNSET masking on columns that had a policy before but no longer do #}
        {% for cur_item in ns_cur.current_masking %}
            {% set ns_found = namespace(found=false) %}
            {% for des_item in ns.column_masking %}
                {% if des_item.name == cur_item.name %}
                    {% set ns_found.found = true %}
                {% endif %}
            {% endfor %}
            {% if ns_found.found == false %}
                {{ stage('Alter Materialized View - Unset Override Masking Policy on ' + cur_item.name) }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    MODIFY COLUMN "{{ cur_item.name }}"
                    UNSET MASKING POLICY
            {% endif %}
        {% endfor %}

        {# SET or FORCE replace masking on columns in desired state #}
        {% for des_item in ns.column_masking %}
            {% set ns_existing = namespace(existing_policy='') %}
            {% for cur_item in ns_cur.current_masking %}
                {% if cur_item.name == des_item.name %}
                    {% set ns_existing.existing_policy = cur_item.masname %}
                {% endif %}
            {% endfor %}

            {% if ns_existing.existing_policy == '' %}
                {# No existing policy — SET #}
                {{ stage('Alter Materialized View - Set Masking Policy on ' + des_item.name) }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    MODIFY COLUMN "{{ des_item.name }}"
                    SET MASKING POLICY {{dbmask}}.{{schmask}}."{{des_item.masname}}"

            {% elif ns_existing.existing_policy != des_item.masname %}
                {# Different policy — FORCE replace #}
                {{ stage('Alter Materialized View - Replace Masking Policy on ' + des_item.name) }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    MODIFY COLUMN "{{ des_item.name }}"
                    SET MASKING POLICY {{dbmask}}.{{schmask}}."{{des_item.masname}}" FORCE
            {% endif %}
        {% endfor %}

    {% endif %}

        {# ---- UNSET ALL — runs independently when masking is fully disabled ---- #}
        {% if desiredState.config.enableMasking == false
            and currentState.config.enableMasking == true %}

            {% for cur_item in ns_cur.current_masking %}
                {{ stage('Alter Materialized View - Unset Masking on ' + cur_item.name) }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    MODIFY COLUMN "{{ cur_item.name }}"
                    UNSET MASKING POLICY
            {% endfor %}

        {% endif %}

        {# ---- ALTER ROW ACCESS POLICY on MV ---- #}
        {% if rowAccessPolicyTest == false or rowAccessPolicyNameTest == false or rowAccessColumnsTest == false or rowAccessLocationTest == false %}

            {# Drop existing row access policy if it was enabled before #}
            {% if currentState.config.enablerowacessMasking == true %}
                {% set cur_racessStorageLocationName = currentState.config.raccessStorageLocationName|trim %}
                {% set cur_dbaccess = ref_no_link(cur_racessStorageLocationName, node.name).split('.')[0] %}
                {% set cur_schaccess = ref_no_link(cur_racessStorageLocationName, node.name).split('.')[1] %}

                {{ stage('Alter Materialized View - Drop Row Access Policy') }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    DROP ROW ACCESS POLICY {{cur_dbaccess}}.{{cur_schaccess}}."{{currentState.config.rowaccessPolicy}}" 
            {% endif %}

            {# Add new row access policy if enabled in desired state #}
            {% if desiredState.config.enablerowacessMasking == true %}
                {{ stage('Alter Materialized View - Add Row Access Policy') }}
                ALTER VIEW {{ desiredFullyQualifiedTargetMaterializedViewName }}
                    ADD ROW ACCESS POLICY {{dbaccess}}.{{schaccess}}."{{desiredState.config.rowaccessPolicy}}" ON({{ns.raccol}})
            {% endif %}

        {% endif %}

    {% endif %}
           
{% elif currentState != undefined and desiredState == undefined %}

    {# Materialized View Name #}
    {% set targetMaterializedViewDatabase = ref_no_link(currentState.node.location.name, currentState.node.name).split('.')[0] %} 
    {% set targetMaterializedViewSchema = ref_no_link(currentState.node.location.name, currentState.node.name).split('.')[1] %} 
    {% set fullyQualifiedTargetMaterializedViewName = ref_no_link(currentState.node.location.name, currentState.node.name) %}

    {{ stage('Drop ' + currentState.node.materializationType ) }}
    {%- set materialization = dropMaterialization(currentState.node.materializationType) -%}
    DROP {{ materialization }} {{ ref_no_link(currentState.node.location.name, currentState.node.name) }}


{% endif %}
